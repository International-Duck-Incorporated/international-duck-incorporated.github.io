# Cloudflare Pages response headers.
# https://developers.cloudflare.com/pages/configuration/headers/
#
# Assets and hashed references below are cache-busted at build time via a
# ?v=<content-hash> query string (see tools/bust_cache.py), so they can be
# cached immutably: when a file changes its URL changes too.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/activity.js
  Cache-Control: public, max-age=31536000, immutable
/bagley-network.js
  Cache-Control: public, max-age=31536000, immutable
/commit-feed.js
  Cache-Control: public, max-age=31536000, immutable
/csharp-rain.js
  Cache-Control: public, max-age=31536000, immutable
/easteregg.js
  Cache-Control: public, max-age=31536000, immutable
/glyphsmith.js
  Cache-Control: public, max-age=31536000, immutable
/matrix-rain.js
  Cache-Control: public, max-age=31536000, immutable
/pixel-canvas.js
  Cache-Control: public, max-age=31536000, immutable
/plus-rain.js
  Cache-Control: public, max-age=31536000, immutable
/script.js
  Cache-Control: public, max-age=31536000, immutable
/starry-night.js
  Cache-Control: public, max-age=31536000, immutable
/storm-window.js
  Cache-Control: public, max-age=31536000, immutable
/venom-hex.js
  Cache-Control: public, max-age=31536000, immutable

# Discovery files must stay fresh so crawlers always see the latest index.
# Firefox only applies the sitemap's XSLT stylesheet when both documents are
# served with XML media types; the default static-asset guesses are not enough.
/sitemap.xml
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: application/xml; charset=utf-8
/sitemap.xsl
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: application/xslt+xml; charset=utf-8
/robots.txt
  Cache-Control: public, max-age=3600, must-revalidate
/llms.txt
  Cache-Control: public, max-age=3600, must-revalidate

# The shared config schema is imported by path (no ?v= hash), so it must stay
# revalidatable: a schema change has to reach the dashboard immediately.
/badegg-config.js
  Cache-Control: public, max-age=0, must-revalidate
