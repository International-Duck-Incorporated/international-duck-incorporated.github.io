+  opacity: .18;
+}
+body[data-project="championscode"] main,
+body[data-project="championscode"] footer,
+body[data-project="nulltrace"] main,
+body[data-project="nulltrace"] footer {
+  position: relative;
+  z-index: 1;
+}
