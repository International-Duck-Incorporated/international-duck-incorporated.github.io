{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "idi",
	"compatibility_date": "2026-10-01",
	"main": "worker.js",
	"assets": {
		"directory": ".",
		"binding": "ASSETS",
		"run_worker_first": true,
	},
	"kv_namespaces": [
		{
			"binding": "IDI_BADEGG",
			"id": "2966263df5e3465ebdfdef2c6158d3e0"
		}
	],
	// Durable console metrics and event history. One shared D1 database, also
	// bound to Agentarium and the Pages site, so deploys and isolate restarts no
	// longer zero the dashboard counters: the status API overlays the persisted
	// fleet totals on this isolate's live memory. Setup once:
	//
	//   npx wrangler d1 create idi-badegg-metrics
	//   npx wrangler d1 execute idi-badegg-metrics --remote --file ./tools/badegg-metrics.sql
	//
	// Paste the database_id printed by the first command below (and into the
	// agentarium repo's wrangler.jsonc). For the Pages site (idi-official) add
	// the same binding in the dashboard under Settings -> Bindings -> D1
	// Database -> BADEGG_DB. Without the binding everything still works with
	// live in-memory numbers only.
	"d1_databases": [
		{
			"binding": "BADEGG_DB",
			"database_name": "idi-badegg-metrics",
			"database_id": "PASTE-DATABASE-ID-HERE"
		}
	],
	// Site label this worker reports under in the shared database. The Pages
	// Functions side (which has no vars) reports as "home" by default.
	"vars": {
		"BADEGG_SITE": "home-worker"
	},
	// BadEgg v3 policy. These env vars are the baseline; anything saved from the
	// dashboard (badegg-v3, feat/idi-pages-dashboard) is stored in the IDI_BADEGG
	// KV namespace under "badegg:v3:config" and wins over them. Clear the KV record
	// (DELETE /api/badegg/config) to fall back to whatever is set here.
	//
	// Every key below is described, bounded and validated by `badegg-config.js`,
	// which this Worker imports and the dashboard shares, so the two cannot drift.
	//
	// Optional BadEgg v3 runtime overrides (defaults match badegg-v3):
	// "vars": {
	//   "BADEGG_MODE": "enforce",               // "enforce" | "monitor"
	//   "BADEGG_RISK_MODE": "minimize_false_bans", // "minimize_false_bans" | "catch_more"
	//   "BADEGG_BAN_TTL_SECONDS": "900",
	//   "BADEGG_BAN_FOREVER": "0",              // "1" = bans never expire
	//   "BADEGG_RATE_LIMIT_REQUESTS": "180",
	//   "BADEGG_RATE_LIMIT_WINDOW_S": "60",
	//   "BADEGG_RATE_LIMIT_BURST": "60",
	//   "BADEGG_RATE_LIMIT_BAN_AFTER": "10",
	//   "BADEGG_ALLOWLIST": "",                 // IPs/CIDRs that skip everything
	//   "BADEGG_BAN_ALWAYS": "",                // IPs/CIDRs blocked on every request
	//   "BADEGG_OUTPUT_ACTION": "redact"        // "redact" | "block" | "alert"
	// },
	// Optional but recommended: cache the blocklist and sync BadEgg v3 temporary
	// exact-IP bans in KV instead of downloading from GitLab on every cold isolate.
	//
	//   wrangler kv namespace create IDI_BADEGG
	//
	// Paste the id below and uncomment. Without the binding BadEgg v3 still works
	// in-isolate and fails open if GitLab is unreachable.
	//
	// "kv_namespaces": [
	//   { "binding": "IDI_BADEGG", "id": "<id from the command above>" }
	// ]
	//
	// The same namespace also stores dashboard-written policy overrides. To enable
	// live editing, bind it as above and add the admin secret the config API
	// authenticates with (16+ characters, never committed):
	//
	//   wrangler secret put BADEGG_ADMIN_TOKEN
	//
	// One secret serves three jobs: it is the bearer token for the config API, the
	// password the dashboard asks for, and the credential for the diagnostics
	// endpoint (?badegg-status=1). Without it those answer 503 and nothing can
	// read or write the policy - the diagnostics endpoint is gated too, because it
	// reports the same settings the login exists to protect.
}