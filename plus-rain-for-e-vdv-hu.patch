+  gl.bindFramebuffer(gl.FRAMEBUFFER, null);
+  gl.viewport(0, 0, renderSpec.width, renderSpec.height);
+  gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);
+
+  useEffect(effectLib.finalComp, renderSpec.mainRT);
+  gl.uniform1i(effectLib.finalComp.program.uniforms.uBloom, 1);
+  gl.activeTexture(gl.TEXTURE1);
+  gl.bindTexture(gl.TEXTURE_2D, renderSpec.wHalfRT0.texture);
+  drawEffect(effectLib.finalComp);
+  unuseEffect(effectLib.finalComp);
+
+  gl.enable(gl.DEPTH_TEST);
+}
+
+function createScene() {
+  createEffectLib();
+  createBackground();
+  createPointFlowers();
+  sceneStandBy = true;
+}
+
+function initScene() {
+  initBackground();
+  initPointFlowers();
+  camera.position.z = pointFlower.area.z + projection.nearfar[0];
+  projection.angle = Math.atan2(pointFlower.area.y, camera.position.z + pointFlower.area.z) * 180.0 / Math.PI * 2.0;
+  Matrix44.loadProjection(projection.matrix, renderSpec.aspect, projection.angle, projection.nearfar[0], projection.nearfar[1]);
+}
+
+function renderScene() {
+  //draw
+  Matrix44.loadLookAt(camera.matrix, camera.position, camera.lookat, camera.up);
+
+  gl.enable(gl.DEPTH_TEST);
+
+  gl.bindFramebuffer(gl.FRAMEBUFFER, renderSpec.mainRT.frameBuffer);
+  gl.viewport(0, 0, renderSpec.mainRT.width, renderSpec.mainRT.height);
+  gl.clearColor(0.005, 0, 0.05, 0);
+  gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);
+
+  renderBackground();
+  renderPointFlowers();
+  renderPostProcess();
+}
+
+function onResize(e) {
+  makeCanvasFullScreen(plusRain.canvas);
+  setViewports();
+  if (sceneStandBy) {
+    initScene();
+  }
+}
+
+function setViewports() {
+  renderSpec.setSize(gl.canvas.width, gl.canvas.height);
+
+  gl.clearColor(0.2, 0.2, 0.5, 1.0);
+  gl.viewport(0, 0, renderSpec.width, renderSpec.height);
+
+  var rtfunc = function (rtname, rtw, rth) {
+    var rt = renderSpec[rtname];
+    if (rt) deleteRenderTarget(rt);
+    renderSpec[rtname] = createRenderTarget(rtw, rth);
+  };
+  rtfunc('mainRT', renderSpec.width, renderSpec.height);
+  rtfunc('wFullRT0', renderSpec.width, renderSpec.height);
+  rtfunc('wFullRT1', renderSpec.width, renderSpec.height);
+  rtfunc('wHalfRT0', renderSpec.halfWidth, renderSpec.halfHeight);
+  rtfunc('wHalfRT1', renderSpec.halfWidth, renderSpec.halfHeight);
+}
+
+function render() {
+  renderScene();
+}
+
+var animating = true;
+function animate() {
+  var curdate = new Date();
+  timeInfo.elapsed = (curdate - timeInfo.start) / 1000.0;
+  timeInfo.delta = (curdate - timeInfo.prev) / 1000.0;
+  timeInfo.prev = curdate;
+
+  if (animating) requestAnimationFrame(animate);
+  render();
+}
+
+function makeCanvasFullScreen(canvas) {
+  // fixed background canvas: always viewport-sized, never document-sized
+  var fullw = window.innerWidth || document.documentElement.clientWidth;
+  var fullh = window.innerHeight || document.documentElement.clientHeight;
+  // retina crispness, capped so huge screens stay smooth
+  var scale = Math.min(window.devicePixelRatio || 1, 2);
+  var px = fullw * fullh * scale * scale;
+  var maxPixels = plusRain.maxPixels;
+  if (px > maxPixels) scale *= Math.sqrt(maxPixels / px);
+  canvas.width = Math.round(fullw * scale);
+  canvas.height = Math.round(fullh * scale);
+  canvas.style.width = fullw + 'px';
+  canvas.style.height = fullh + 'px';
+}
+
+function loadImage(src) {
+  return new Promise(function (resolve, reject) {
+    var img = new Image();
+    img.onload = function () { resolve(img); };
+    img.onerror = reject;
+    img.src = src;
+  });
+}
+
+var plusRain = {};
+
+function fallback() {
+  document.body.classList.add('plus-rain-fallback');
+  if (plusRain.canvas) plusRain.canvas.style.display = 'none';
+}
+
+function createGL(canvas) {
+  try {
+    return canvas.getContext('webgl', { alpha: false }) ||
+           canvas.getContext('experimental-webgl', { alpha: false });
+  } catch (e) {
+    return null;
+  }
+}
+
+function webglSupported() {
+  try {
+    var probe = document.createElement('canvas');
+    return !!(probe.getContext('webgl') || probe.getContext('experimental-webgl'));
+  } catch (e) {
+    return false;
+  }
+}
+
+var glReady = false;
+var imagesReady = false;
+
+function tryComplete() {
+  if (!glReady || !imagesReady) return;
+
+  try {
+    makeCanvasFullScreen(plusRain.canvas);
+    window.addEventListener('resize', onResize);
+
+    setViewports();
+    createScene();
+    initScene();
+  } catch (err) {
+    console.error(err);
+    fallback();
+    return;
+  }
+
+  timeInfo.start = new Date();
+  timeInfo.prev = timeInfo.start;
+
+  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+  if (reduceMotion) {
+    animating = false;
+    timeInfo.delta = 1 / 60;
+    render();
+  } else {
+    animate();
+  }
+}
+
+function init() {
+  var canvas = document.querySelector('[data-plus-rain]');
+  if (!canvas) return;
+
+  plusRain.canvas = canvas;
+  plusRain.maxPixels = parseFloat(canvas.dataset.rainMaxPixels || '3500000');
+  background.dim = parseFloat(canvas.dataset.rainDim || '0.45');
+
+  var spriteSrc = canvas.dataset.rainSprite;
+  var bgSrc = canvas.dataset.rainBackground;
+  if (!spriteSrc || !bgSrc) return;
+
+  // Context and images are prepared independently; the scene builds once both are ready.
+  loadImage(spriteSrc).then(function (img) {
+    pointFlower.spriteImage = img;
+    return loadImage(bgSrc);
+  }).then(function (img) {
+    background.image = img;
+    imagesReady = true;
+    tryComplete();
+  }).catch(function (err) {
+    console.error(err);
+    fallback();
+  });
+
+  // Context creation can fail transiently while the page is busy loading.
+  // Retry a few times, but fall back immediately when WebGL is really unavailable.
+  var delays = [300, 1200, 4000];
+  var attempt = 0;
+  (function tryGL() {
+    gl = createGL(canvas);
+    if (gl) {
+      glReady = true;
+      tryComplete();
+      return;
+    }
+    if (!webglSupported()) {
+      fallback();
+      return;
+    }
+    if (attempt < delays.length) {
+      setTimeout(tryGL, delays[attempt]);
+      attempt += 1;
+    } else {
+      fallback();
+    }
+  })();
+}
+
+if (document.readyState === 'loading') {
+  document.addEventListener('DOMContentLoaded', init);
+} else {
+  init();
+}
+
+})();
