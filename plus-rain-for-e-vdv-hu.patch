+    repeatPos(prtcl, 0, pointFlower.area.x);
+    repeatPos(prtcl, 1, pointFlower.area.y);
+    repeatPos(prtcl, 2, pointFlower.area.z);
+    repeatEuler(prtcl, 0);
+    repeatEuler(prtcl, 1);
+    repeatEuler(prtcl, 2);
