+        prt.position[cmp] += limit * 2.0;
+      }
+    }
+  };
+  var repeatEuler = function (prt, cmp) {
+    prt.euler[cmp] = prt.euler[cmp] % PI2;
+    if (prt.euler[cmp] < 0.0) {
