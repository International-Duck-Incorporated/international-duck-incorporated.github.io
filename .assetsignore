# Keep repository metadata and generated tooling files out of static asset uploads.
.git/
.wrangler/
functions/
worker.js
node_modules/
.npm/
.cache/
.config/
*.patch
patch_final_verified.txt

# Assets are served publicly. Never upload local credentials or backup dumps.
.env*
.dev.vars*
.npmrc
.netrc
*.pem
*.key
*.p12
*.pfx
*.sql
*.sql.gz
*.bak


# Development files are Worker inputs, not public website assets.
.github/
.gitlab-ci.yml
.editorconfig
.prettierignore
.prettierrc.json
wrangler.jsonc
badegg-config.js
tools/
__pycache__/
*.pyc
.gitignore
pyproject.toml
